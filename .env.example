# Copie para `.env` e preencha. O `.env` real NUNCA vai para o git (CLAUDE.md, Seção 6).

# --- Banco de dados (Fase 0) ---
# Connection string do Postgres. Produção: Neon (free tier). Dev offline: docker compose up -d.
# Também precisa ser cadastrada como secret DATABASE_URL do repositório no GitHub
# (Settings → Secrets and variables → Actions), pois os workflows gravam direto no banco.
DATABASE_URL="postgresql://bot_cnpi:bot_cnpi@localhost:5432/bot_cnpi"
# No Neon: mesma string, mas com o host SEM o sufixo "-pooler" — usada só pelo
# Prisma CLI (migrations). Com Postgres local, pode deixar vazia.
DATABASE_URL_DIRECT=""  

# --- Autenticação de usuário único (Fase 0) ---
# Credenciais do único usuário do sistema (multiusuário só na Fase 8).
AUTH_EMAIL="voce@exemplo.com"
AUTH_PASSWORD="escolha-uma-senha-forte"
# Chave usada para assinar o cookie de sessão. Gere com: openssl rand -hex 32
AUTH_SECRET=""

# --- GitHub Actions (Fase 0/2) ---
# Personal Access Token com permissão `actions: write` no repositório, usado pela API
# do Next.js para disparar o workflow pepi-search.yml via workflow_dispatch.
GITHUB_PAT=""
# Repositório onde os workflows vivem, no formato dono/nome (ex: daviolive/bot-cnpi).
GITHUB_REPO=""

# --- E-mail: Resend (PADRÃO, Fases 5 e 6) ---
# Provedor padrão de envio. A chave é do OPERADOR, não do usuário final: ela dá
# permissão de envio no domínio inteiro, então nunca vai para o banco nem para uma
# tela de configuração — só para cá e para os secrets do repositório no GitHub.
# Se estas duas estiverem preenchidas, o Resend é usado e o SMTP abaixo é ignorado.
RESEND_API_KEY=""
# Remetente. O domínio precisa estar VERIFICADO no Resend (DNS de DKIM/SPF), senão
# a API recusa com 403/422. Recomendado usar um subdomínio dedicado a envio, para
# a reputação do domínio principal não depender disto:
#   "Monitor de Marcas <avisos@avisos.trilhafinance.com.br>"
EMAIL_REMETENTE=""
# Para onde vai a resposta se o usuário responder o alerta (o remetente acima é um
# endereço de envio, que ninguém lê). Vazio = sem reply-to.
EMAIL_RESPONDER_PARA=""

# --- E-mail: SMTP (fallback, Fases 5 e 6) ---
# Só é usado quando RESEND_API_KEY/EMAIL_REMETENTE estão vazias. Serve para quem
# preferir o próprio servidor. Atenção com Gmail: exige 2FA ativo + "senha de app"
# (a senha normal da conta não funciona desde 2022).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
# "ssl" força TLS implícito; vazio/qualquer outro valor usa STARTTLS (a porta 465
# já liga o SSL sozinha).
SMTP_CRIPTOGRAFIA=""

# Destinatário do resumo de prazos. Vazio = e-mail do usuário cadastrado.
RESUMO_PRAZOS_PARA=""

# --- WhatsApp Cloud API da Meta (Fase 6) ---
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# --- Só no Vercel (Fase 9) ---
# NÃO defina estas aqui: elas existem apenas no painel do projeto no Vercel.
#
# PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
#   O Vercel instala devDependencies para buildar, e o pacote `playwright` baixa
#   um Chromium inteiro na instalação — centenas de MB para algo que o Vercel
#   nunca executa (CLAUDE.md Seção 5: todo Playwright vive no GitHub Actions).
#   Sem isso o build funciona, só lento e pesado. Não tem efeito local.
#
# Quais destas variáveis vão para o Vercel: DATABASE_URL, AUTH_EMAIL,
# AUTH_PASSWORD, AUTH_SECRET, GITHUB_PAT, GITHUB_REPO, RESEND_API_KEY,
# EMAIL_REMETENTE (+ EMAIL_RESPONDER_PARA / RESUMO_PRAZOS_PARA se usadas).
# NÃO vão: DATABASE_URL_DIRECT (só o Prisma CLI, nas migrations) e as SMTP_*
# quando o Resend estiver em uso. Os valores saem DAQUI, não dos secrets do
# GitHub — secret do GitHub não pode ser lido de volta depois de salvo.
#
# O app não envia e-mail (quem envia é o worker no Actions); ele precisa das
# credenciais de e-mail para a tela de Configurações de Alertas conseguir
# diagnosticar o canal. Ver CLAUDE.md Seção 3.3.
