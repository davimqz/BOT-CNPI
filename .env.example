# Copie para `.env` e preencha. O `.env` real NUNCA vai para o git (CLAUDE.md, Seção 6).

# --- Banco de dados (Fase 0) ---
# Connection string do Postgres. Produção: Neon (free tier). Dev offline: docker compose up -d.
# Também precisa ser cadastrada como secret DATABASE_URL do repositório no GitHub
# (Settings → Secrets and variables → Actions), pois os workflows gravam direto no banco.
DATABASE_URL="postgresql://bot_cnpi:bot_cnpi@localhost:5432/bot_cnpi"
# No Neon: mesma string, mas com o host SEM o sufixo "-pooler" — usada só pelo
# Prisma CLI (migrations). Com Postgres local, pode deixar vazia.
DATABASE_URL_DIRECT=""

# --- Autenticação de usuário único (Fase 0) ---
# Credenciais do único usuário do sistema (multiusuário só na Fase 8).
AUTH_EMAIL="voce@exemplo.com"
AUTH_PASSWORD="escolha-uma-senha-forte"
# Chave usada para assinar o cookie de sessão. Gere com: openssl rand -hex 32
AUTH_SECRET=""

# --- GitHub Actions (Fase 0/2) ---
# Personal Access Token com permissão `actions: write` no repositório, usado pela API
# do Next.js para disparar o workflow pepi-search.yml via workflow_dispatch.
GITHUB_PAT=""
# Repositório onde os workflows vivem, no formato dono/nome (ex: daviolive/bot-cnpi).
GITHUB_REPO=""

# --- E-mail / SMTP (Fase 6) ---
# Preferencialmente configurado pela tela de alertas; estas variáveis são fallback/dev.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# --- WhatsApp Cloud API da Meta (Fase 6) ---
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
