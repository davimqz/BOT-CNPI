// Schema inicial — estrutura das 9 tabelas do CLAUDE.md (Seção 4), sem lógica de negócio.
// Ao alterar este schema, atualize também o quadro da Seção 4 do CLAUDE.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Fonte de dados de uma marca monitorada — decisão de arquitetura, ver CLAUDE.md Seção 2.
enum FonteDados {
  rpi
  scraping
}

enum TipoBusca {
  radical
  exata
  processo // busca por nº de processo/protocolo (Pesquisa_num_processo.jsp)
  titular // busca por depositante/titular — nome/razão social ou CPF/CNPJ (Pesquisa_titular.jsp)
}

enum StatusPrazo {
  pendente
  cumprido
  vencido
}

enum StatusJobBusca {
  pendente
  executando
  sucesso
  erro
}

// Como um despacho chegou até a marca vinculada (Fase 4) — espelha
// MotivoCruzamento de src/lib/verificacao.ts. `similaridade` é colidência:
// marca de TERCEIRO parecida com a monitorada, nunca movimentação própria.
enum MotivoVinculo {
  processo
  nome
  similaridade
}

// Conta/dono da configuração (usuário único nesta versão; multiusuário só na Fase 8).
model Usuario {
  id        String   @id @default(cuid())
  email     String   @unique
  nome      String
  senhaHash String   @map("senha_hash")
  criadoEm  DateTime @default(now()) @map("criado_em")

  clientes            Cliente[]
  marcasMonitoradas   MarcaMonitorada[]
  templates           Template[]
  configuracoesAlerta ConfiguracaoAlerta[]

  @@map("usuarios")
}

// Pessoas/empresas para quem uma marca é monitorada (dispensável no uso pessoal).
model Cliente {
  id        String   @id @default(cuid())
  usuarioId String   @map("usuario_id")
  nome      String
  email     String?
  whatsapp  String?
  criadoEm  DateTime @default(now()) @map("criado_em")

  usuario Usuario           @relation(fields: [usuarioId], references: [id])
  marcas  MarcaMonitorada[]

  @@map("clientes")
}

model MarcaMonitorada {
  id                    String     @id @default(cuid())
  usuarioId             String     @map("usuario_id")
  clienteId             String?    @map("cliente_id")
  nome                  String
  processo              String?
  classeNcl             String?    @map("classe_ncl")
  tipoBusca             TipoBusca  @default(radical) @map("tipo_busca")
  similaridadeAtiva     Boolean    @default(false) @map("similaridade_ativa")
  // Percentual 0-100; só relevante quando similaridadeAtiva = true (Fase 4).
  similaridadeThreshold Int?       @map("similaridade_threshold")
  fonteDados            FonteDados @default(rpi) @map("fonte_dados")
  // Slugs de evento (src/lib/eventos-alerta.ts) que disparam alerta; vazio = todos.
  // Slug em vez de código IPAS: o mapeamento evento→códigos pode ganhar códigos
  // novos sem exigir migração das marcas já cadastradas.
  eventosAlerta         String[]   @default([]) @map("eventos_alerta")
  ativa                 Boolean    @default(true)
  criadoEm              DateTime   @default(now()) @map("criado_em")
  // Só para fonteDados = scraping (workflow pepi-monitor.yml): último retrato
  // "processo → situação" visto no pePI. A mudança em relação a este retrato é o
  // que caracteriza "movimentação nova" nessa fonte — na fonte rpi quem faz esse
  // papel é o despacho publicado na edição.
  ultimoSnapshotPepi    Json?      @map("ultimo_snapshot_pepi")
  verificadoEm          DateTime?  @map("verificado_em")

  usuario   Usuario    @relation(fields: [usuarioId], references: [id])
  cliente   Cliente?   @relation(fields: [clienteId], references: [id])
  despachos Despacho[]

  @@map("marcas_monitoradas")
}

// Movimentação capturada de uma edição da RPI (ou do pePI, na fonte scraping —
// nesse caso `edicaoRpiId` é nulo e o código é o sintético CODIGO_DESPACHO_PEPI
// de src/lib/verificacao.ts, que não existe na tabela de códigos do INPI).
model Despacho {
  id             String   @id @default(cuid())
  marcaId        String?  @map("marca_id")
  edicaoRpiId    String?  @map("edicao_rpi_id")
  processo       String
  nomeMarca      String?  @map("nome_marca")
  titular        String?
  classeNcl      String?  @map("classe_ncl")
  codigo            String
  textoDespacho     String?  @map("texto_despacho")
  textoComplementar String?  @map("texto_complementar")
  dataPublicacao    DateTime @map("data_publicacao")
  // Marcado pelo job de verificação (Fase 3) quando o despacho bate com uma marca
  // monitorada E o código está entre os eventos escolhidos por ela. O envio da
  // Fase 6 consome esta fila e zera a flag — nunca reprocessar a edição inteira.
  alertaPendente    Boolean  @default(false) @map("alerta_pendente")
  // Persistido no cruzamento (src/lib/verificacao.ts::Cruzamento) — antes disso
  // o motivo era recomputado a cada leitura. Nulo enquanto marcaId for nulo, ou
  // em despacho vinculado antes desta coluna existir (backfill: `npm run
  // ingest:rpi -- --recalcular-motivo`). A tela de Colidências (/marcas/colidencias)
  // é só `motivoVinculo = similaridade`.
  motivoVinculo     MotivoVinculo? @map("motivo_vinculo")
  // Percentual 0-100 da comparação nome a nome; só presente quando
  // motivoVinculo = similaridade (`casaPorSimilaridade` em verificacao.ts).
  similaridadeScore Int?     @map("similaridade_score")
  criadoEm       DateTime @default(now()) @map("criado_em")

  marca     MarcaMonitorada? @relation(fields: [marcaId], references: [id])
  edicaoRpi EdicaoRpi?       @relation(fields: [edicaoRpiId], references: [id])
  prazos    Prazo[]

  @@index([processo])
  @@index([codigo])
  @@index([marcaId, alertaPendente])
  @@index([motivoVinculo])
  @@map("despachos")
}

// Prazo legal derivado de um despacho (Fase 5). As regras foram validadas contra a
// LPI e o Manual de Marcas (CLAUDE.md Seção 5) — a tabela com o fundamento de cada
// uma está em .claude/skills/rpi-ingestion-despachos/references/despacho-codes.md,
// e o cálculo em src/lib/prazos.ts.
model Prazo {
  id         String      @id @default(cuid())
  despachoId String      @map("despacho_id")
  /// Slug de TipoPrazo (src/lib/prazos.ts), não o rótulo exibido: o texto da tela
  /// pode ser reescrito sem migrar as linhas já gravadas.
  tipo       String
  dataLimite DateTime    @map("data_limite")
  status     StatusPrazo @default(pendente)
  criadoEm   DateTime    @default(now()) @map("criado_em")

  despacho Despacho @relation(fields: [despachoId], references: [id], onDelete: Cascade)

  /// Idempotência da ingestão: re-rodar uma edição recalcula o mesmo prazo em vez
  /// de criar uma segunda linha. Um despacho pode ter mais de um prazo de tipos
  /// diferentes (deferimento abre o pagamento ordinário e o extraordinário).
  @@unique([despachoId, tipo])
  @@index([status, dataLimite])
  @@map("prazos")
}

// Cache local de cada edição da RPI já processada. É também o catálogo da tela
// /revistas (Revistas INPI) — e por isso NUNCA é apagado pela limpeza da janela
// móvel: o histórico de revistas continua completo mesmo sem os despachos.
model EdicaoRpi {
  id             String   @id @default(cuid())
  numero         Int      @unique
  dataPublicacao DateTime @map("data_publicacao")
  processadoEm   DateTime @default(now()) @map("processado_em")
  // Edição processada no MODO ENXUTO: foi baixada e cruzada por inteiro, mas só
  // os despachos que casaram com marca monitorada foram gravados. Alerta, prazo e
  // colidência têm a mesma fidelidade do modo completo; o que não existe aqui é o
  // despacho de terceiro para navegar no Histórico RPI.
  //
  // A coluna existe para o `--recruzar` não dar resposta silenciosamente errada:
  // recruzar uma edição enxuta encontraria "nada" e uma marca nova concluiria que
  // não houve movimentação, quando na verdade os dados nunca estiveram no banco.
  enxuta         Boolean  @default(false)

  despachos Despacho[]

  @@map("edicoes_rpi")
}

// Personalização de marca própria (white-label) — campos usados de fato só na Fase 7.
model Template {
  id              String   @id @default(cuid())
  usuarioId       String   @unique @map("usuario_id")
  nomeEscritorio  String?  @map("nome_escritorio")
  telefone        String?
  emailContato    String?  @map("email_contato")
  site            String?
  logoUrl         String?  @map("logo_url")
  ocultarLogo     Boolean  @default(false) @map("ocultar_logo")
  corDestaque     String?  @map("cor_destaque")
  textoRodape     String?  @map("texto_rodape")
  emailAssunto    String?  @map("email_assunto")
  emailCabecalho  String?  @map("email_cabecalho")
  emailTextoIntro String?  @map("email_texto_intro")
  emailRodape     String?  @map("email_rodape")
  assinatura      String?
  atualizadoEm    DateTime @updatedAt @map("atualizado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@map("templates")
}

// Canais habilitados e parâmetros de envio por usuário (Fase 6).
model ConfiguracaoAlerta {
  id                      String   @id @default(cuid())
  usuarioId               String   @unique @map("usuario_id")
  // Consultado pelos workers antes de enviar (canalEmailLiberado). Default
  // `true` porque o padrão de um sistema de prazos é avisar: silêncio só por
  // escolha explícita na tela de Configurações de Alertas.
  emailHabilitado         Boolean  @default(true) @map("email_habilitado")
  whatsappHabilitado      Boolean  @default(false) @map("whatsapp_habilitado")
  popupHabilitado         Boolean  @default(true) @map("popup_habilitado")
  // Até quando o usuário já viu as novidades no pop-up (Fase 6). Nulo = nunca
  // marcou nada como visto. É o estado do canal "pop-up", que NÃO pode se apoiar
  // em `despachos.alerta_pendente`: aquela fila é zerada pelo envio de e-mail, e
  // um pop-up que lê a fila apagaria justamente quando o e-mail volta a
  // funcionar. Ver src/lib/novidades.ts.
  alertasVistosEm         DateTime? @map("alertas_vistos_em")
  // ESCOPO REMOVIDO (28/07/2026, ver TASKS.md Fase 6): o delay configurável de
  // e-mail não foi construído — num sistema de prazos ele só permite piorar o
  // alerta, e o melhor valor é sempre 0. A coluna permanece porque removê-la
  // custa uma migration sem nenhum ganho; não implemente em cima dela.
  delayEmailMinutos       Int      @default(0) @map("delay_email_minutos")
  intervaloWhatsappSeg    Int      @default(30) @map("intervalo_whatsapp_seg")
  smtpHost                String?  @map("smtp_host")
  smtpPorta               Int?     @map("smtp_porta")
  smtpUsuario             String?  @map("smtp_usuario")
  smtpSenha               String?  @map("smtp_senha")
  smtpRemetente           String?  @map("smtp_remetente")
  smtpCriptografia        String?  @map("smtp_criptografia")
  atualizadoEm            DateTime @updatedAt @map("atualizado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@map("configuracoes_alerta")
}

// Job de busca ao vivo no pePI (Fase 2): a API cria a linha como `pendente`,
// dispara o workflow pepi-search.yml via workflow_dispatch passando o id, e o
// worker no GitHub Actions atualiza status/etapa/resultado; o frontend faz polling.
model PepiSearchJob {
  id           String         @id @default(cuid())
  termo        String
  tipoBusca    TipoBusca      @map("tipo_busca")
  classeNcl    String?        @map("classe_ncl")
  status       StatusJobBusca @default(pendente)
  // Última etapa da automação ("acessando site", "extraindo resultados p.2"...),
  // exibida pelo polling para o usuário nunca ficar sem feedback.
  etapa        String?
  resultado    Json?
  erro         String?
  criadoEm     DateTime       @default(now()) @map("criado_em")
  finalizadoEm DateTime?      @map("finalizado_em")

  @@index([status, criadoEm])
  @@map("pepi_search_jobs")
}

// Job de detalhe de processo pePI: a API cria a linha como `pendente` ao clicar
// num processo do resultado da busca, dispara pepi-detalhe.yml via
// workflow_dispatch passando CodPedido, e o worker grava o resultado; o
// frontend faz polling (mesmo padrão de PepiSearchJob). `codPedido` é o
// identificador de sessão que o pePI usa na URL de detalhe
// (Action=detail&CodPedido=N) — capturado no resultado da busca por marca.
// Sem campo de imagem do protocolo: só aparece autenticado como titular do
// processo, fora do alcance da sessão anônima usada aqui (ver skill
// pepi-scraping-playbook).
model PepiDetalheJob {
  id           String         @id @default(cuid())
  codPedido    String         @map("cod_pedido")
  processo     String
  status       StatusJobBusca @default(pendente)
  etapa        String?
  resultado    Json?
  erro         String?
  criadoEm     DateTime       @default(now()) @map("criado_em")
  finalizadoEm DateTime?      @map("finalizado_em")

  @@index([status, criadoEm])
  // Reaproveitar um job recente bem-sucedido do mesmo processo em vez de
  // disparar um novo workflow a cada clique (rate limit contra o pePI).
  @@index([codPedido, status, finalizadoEm])
  @@map("pepi_detalhe_jobs")
}

// Registro de cada rodada de busca/monitoramento, para auditoria e depuração.
model LogExecucao {
  id           String    @id @default(cuid())
  tipo         String
  status       String
  mensagem     String?
  detalhes     Json?
  iniciadoEm   DateTime  @default(now()) @map("iniciado_em")
  finalizadoEm DateTime? @map("finalizado_em")

  @@index([tipo, iniciadoEm])
  @@map("logs_execucao")
}
